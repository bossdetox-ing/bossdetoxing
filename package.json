{
  "name": "bossdetox-ing",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt --no-open",
    "build": "wxt build && node scripts/notices.mjs",
    "zip": "npm run package",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src entrypoints tests scripts pwa *.ts *.js",
    "test": "vitest run",
    "test:e2e": "npm run typecheck && npm run build && npm run audit:build && playwright test",
    "audit:build": "node scripts/audit-build.mjs",
    "format": "prettier --write src entrypoints tests scripts/*.mjs *.ts *.js *.json README.md",
    "format:check": "prettier --check src entrypoints tests scripts/*.mjs *.ts *.js *.json README.md",
    "package": "npm run typecheck && npm run build && npm run audit:build && python3 scripts/package.py",
    "postinstall": "wxt prepare",
    "build:web": "vite build --config pwa/vite.config.ts && node scripts/pwa.mjs",
    "preview:web": "vite preview --config pwa/vite.config.ts",
    "test:web": "npm run build:web && playwright test --config playwright.web.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "astronomy-engine": "^2.1.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "pixelarticons": "^2.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.7",
    "opentype.js": "^1.3.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wxt": "^0.20.27"
  },
  "overrides": {
    "shell-quote": "^1.8.5",
    "adm-zip": "^0.6.1",
    "tmp": "^0.2.6"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "license": "MIT"
}
